---
import type { EventItem } from '@/data/events';

interface Props {
  events: EventItem[];
  heading: string;
  note?: string;
}

const { events, heading, note } = Astro.props;

const categoryClasses: Record<string, string> = {
  '祭り': 'bg-festival text-white',
  '地域': 'bg-moss text-white',
  '文化': 'bg-night text-white',
  'スポーツ': 'bg-sun text-ink',
  '季節': 'bg-leaf text-white',
};
---

<section class="section-shell">
  <div class="container-site">
    <div class="rounded-[2rem] border border-black/10 bg-white p-7 sm:p-9">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="font-serif text-2xl font-bold sm:text-3xl">{heading}</h2>
        <a href="/events" class="text-sm font-bold text-moss">すべての予定 ↗</a>
      </div>
      <ul class="mt-6 divide-y divide-black/[0.08]">
        {events.map((e) => (
          <li class="flex items-center gap-4 py-3.5">
            <span class="w-24 shrink-0 font-serif text-lg font-bold text-ink/70">{e.date}</span>
            {e.slug ? (
              <a href={`/events/${e.slug}`} class="flex-1 font-bold text-moss transition hover:underline">{e.title}</a>
            ) : (
              <span class="flex-1 font-bold">{e.title}</span>
            )}
            <span class:list={['shrink-0 rounded-full px-3 py-1 text-xs font-black', categoryClasses[e.category]]}>{e.category}</span>
          </li>
        ))}
      </ul>
      {note && <p class="mt-4 text-xs leading-6 text-ink/50">{note}</p>}
    </div>
  </div>
</section>
