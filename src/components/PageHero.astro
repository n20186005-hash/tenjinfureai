---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}
const { eyebrow, title, description, image, imageAlt = '' } = Astro.props;
---
<section class="relative overflow-hidden pb-16 pt-32 sm:pb-24 sm:pt-40">
  <div class="pointer-events-none absolute -right-20 top-24 size-80 rounded-full bg-sun/10 blur-3xl"></div>
  <div class="container-site grid items-end gap-12 lg:grid-cols-[0.85fr_1.15fr]">
    <div class="relative z-10">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display-title mt-6 text-balance text-5xl sm:text-6xl lg:text-7xl">{title}</h1>
      <p class="mt-7 max-w-xl text-base leading-8 text-ink/[0.65] sm:text-lg">{description}</p>
    </div>
    {image && (
      <figure class="relative overflow-hidden rounded-[2rem] shadow-soft">
        <img src={image} alt={imageAlt} class="aspect-[16/10] h-full w-full object-cover" width="1200" height="750" loading="eager" />
        <div class="absolute inset-0 bg-linear-to-t from-ink/30 via-transparent to-transparent"></div>
      </figure>
    )}
  </div>
</section>
