---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/images/plaza/festival-dance.webp',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title}｜${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: '福岡市役所西側ふれあい広場',
  alternateName: 'Fukuoka City Hall West Side Fureai Plaza',
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    postalCode: '810-0001',
    addressRegion: '福岡県',
    addressLocality: '福岡市中央区',
    streetAddress: '天神1丁目8-1',
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.coordinates.latitude,
    longitude: site.coordinates.longitude,
  },
  openingHours: 'Mo-Su 08:00-21:00',
  isAccessibleForFree: true,
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5ed" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4}`}></script>
    <script is:inline define:vars={{ measurementId: site.ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', measurementId);
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
