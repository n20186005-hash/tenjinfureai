---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { foodSpots } from '@/data/food';
---
<BaseLayout title="周辺グルメ" description="福岡市役所西側ふれあい広場から歩いて行ける、明太子、鉄板ホルモン、もつ鍋など天神・西中洲の福岡グルメ案内。" image="/images/food/mentaiju.webp">
  <PageHero
    eyebrow="LOCAL FOOD"
    title="祭りの前も、帰り道も、福岡の味。"
    description="広場から徒歩圏で楽しめる、福岡らしい三軒。朝、昼、夜の過ごし方に合わせて選べます。"
    image="/images/food/mentaiju.webp"
    imageAlt="元祖博多めんたい重の店舗外観"
  />

  <section class="section-shell pt-4">
    <div class="container-site space-y-8">
      {foodSpots.map((spot, index) => (
        <article class="grid overflow-hidden rounded-[2rem] border border-black/10 bg-white lg:grid-cols-2">
          <div class:list={['overflow-hidden', index % 2 === 1 && 'lg:order-2']}>
            <img src={spot.image} alt={spot.imageAlt} class="aspect-[4/3] size-full object-cover" width="1000" height="750" loading={index === 0 ? 'eager' : 'lazy'} />
          </div>
          <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
            <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
              <span class="rounded-full bg-moss px-3 py-1.5 text-white">{spot.genre}</span>
              <span class="rounded-full bg-paper px-3 py-1.5 text-moss">広場から {spot.walk}</span>
            </div>
            <h2 class="mt-5 font-serif text-3xl font-bold sm:text-4xl">{spot.name}</h2>
            <p class="mt-2 text-xs tracking-[0.12em] text-ink/40">{spot.reading}</p>
            <p class="mt-6 text-base leading-8 text-ink/[0.65]">{spot.description}</p>
            <dl class="mt-7 grid gap-4 border-t border-black/10 pt-6 text-sm sm:grid-cols-2">
              <div>
                <dt class="font-black text-moss">おすすめ</dt>
                <dd class="mt-1 leading-6 text-ink/[0.65]">{spot.signature}</dd>
              </div>
              <div>
                <dt class="font-black text-moss">住所</dt>
                <dd class="mt-1 leading-6 text-ink/[0.65]">{spot.address}</dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="font-black text-moss">営業時間の目安</dt>
                <dd class="mt-1 leading-6 text-ink/[0.65]">{spot.hours}</dd>
              </div>
            </dl>
          </div>
        </article>
      ))}
      <p class="text-xs leading-6 text-ink/50">※徒歩時間はふれあい広場を起点とした概算です。営業時間、休業日、受付終了時間、予約条件は変更される場合があります。来店前に各店舗の最新案内をご確認ください。</p>
    </div>
  </section>

  <section class="section-shell bg-ink text-paper">
    <div class="container-site">
      <SectionHeading eyebrow="CHOOSE YOUR PLAN" title="時間帯で選ぶ、食の寄り道。" />
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {[
          ['朝から福岡らしく', '07:00–', '早い時間は明太子料理から。観光を始める前に、福岡らしい一膳をゆっくり。'],
          ['昼は手早く、熱々で', '11:00–', 'イベントの合間や買い物途中には、鉄板のライブ感が楽しい定食を。'],
          ['夜はみんなで囲む', '17:00–', '祭りやステージの余韻をそのままに、もつ鍋を囲んで一日を締めくくる。'],
        ].map(([title, time, body], index) => (
          <article class="rounded-[1.75rem] border border-white/[0.12] bg-white/[0.06] p-7">
            <div class="flex items-center justify-between">
              <span class="font-serif text-5xl font-bold text-sun/40">0{index + 1}</span>
              <span class="rounded-full bg-white/10 px-3 py-1.5 text-xs font-black text-sun">{time}</span>
            </div>
            <h3 class="mt-7 text-xl font-bold">{title}</h3>
            <p class="mt-4 text-sm leading-7 text-paper/60">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container-site grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-center">
      <div>
        <p class="eyebrow">AFTER THE MEAL</p>
        <h2 class="display-title mt-5 text-4xl sm:text-5xl">食後は、川辺と歴史へ。</h2>
        <p class="mt-6 text-base leading-8 text-ink/[0.65]">西中洲や天神で食事をした後は、天神中央公園、水鏡天満宮、貴賓館まで歩いてみませんか。</p>
        <a href="/nearby" class="mt-7 inline-flex rounded-full bg-ink px-5 py-3 text-sm font-bold text-white">周辺スポットを見る</a>
      </div>
      <img src="/images/nearby/kihinkan.webp" alt="旧福岡県公会堂貴賓館" class="aspect-[16/9] w-full rounded-[2rem] object-cover shadow-soft" width="1100" height="620" loading="lazy" />
    </div>
  </section>
</BaseLayout>
