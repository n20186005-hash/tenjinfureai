---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import RouteMap from '@/components/RouteMap.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqSection from '@/components/FaqSection.astro';
import { site } from '@/data/site';

const routes = [
  {
    from: '福岡空港から',
    icon: '空',
    color: 'bg-night',
    time: '約15分',
    steps: ['地下鉄空港線で「天神駅」まで約11分', '13A出口方面へ進む', '地上に出て福岡市役所方面へ徒歩約4〜5分'],
  },
  {
    from: 'JR博多駅から',
    icon: '博',
    color: 'bg-festival',
    time: '約9分',
    steps: ['地下鉄空港線で「天神駅」まで約5分', '13A出口方面へ進む', '福岡市役所西側まで徒歩約4分'],
  },
  {
    from: '博多駅・七隈線から',
    icon: '七',
    color: 'bg-moss',
    time: '約8分',
    steps: ['地下鉄七隈線で「天神南駅」まで約5分', '5番出口方面へ進む', '渡辺通りを北へ、広場まで徒歩約3分'],
  },
  {
    from: '西鉄福岡（天神）駅から',
    icon: '西',
    color: 'bg-sun text-ink',
    time: '徒歩約4分',
    steps: ['駅を出て天神交差点・市役所方面へ', '渡辺通り東側へ進む', '福岡市役所の西側に広場があります'],
  },
];
---
<BaseLayout pageTitleOverride="福岡市役所西側ふれあい広場のアクセス｜天神駅・駐車場・行き方"
  description="福岡市役所西側ふれあい広場へのアクセス。地下鉄天神駅・天神南駅、西鉄福岡（天神）駅からの徒歩ルート、周辺駐車場、イベント時の交通規制についてまとめました。"
  image="/images/plaza/plaza-aerial.webp">
  <PageHero
    eyebrow="DETAILED ACCESS"
    title="天神駅から、街の風景を目印に。"
    description="地下鉄・西鉄・バスの主要駅から徒歩数分。空港や博多駅からも乗り換えなしで向かえます。"
    image="/images/plaza/plaza-aerial.webp"
    imageAlt="天神の街並みと福岡市役所西側ふれあい広場"
  />

  <section class="section-shell pt-4">
    <div class="container-site">
      <div class="flex flex-col gap-4 rounded-[1.5rem] border border-black/10 bg-white p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="eyebrow">QUICK NAVIGATION</p>
          <p class="mt-2 font-serif text-2xl font-bold">地図でルートを確認。</p>
          <p class="mt-1 text-sm text-ink/60">現在地からの経路を、地図アプリですぐに開けます。</p>
        </div>
        <a href={site.mapUrl} target="_blank" rel="noreferrer" class="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-black text-white">地図・経路を開く ↗</a>
      </div>
    </div>
  </section>

  <section class="section-shell pt-4">
    <div class="container-site">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {routes.map((route) => (
          <article class="card-surface p-6">
            <div class="flex items-center justify-between gap-4">
              <span class:list={['grid size-11 place-items-center rounded-full text-sm font-black text-white', route.color]}>{route.icon}</span>
              <span class="rounded-full bg-paper px-3 py-1.5 text-xs font-black text-moss">{route.time}</span>
            </div>
            <h2 class="mt-6 font-serif text-xl font-bold">{route.from}</h2>
            <ol class="mt-5 space-y-4">
              {route.steps.map((step, index) => (
                <li class="flex gap-3 text-sm leading-6 text-ink/[0.65]">
                  <span class="grid size-6 shrink-0 place-items-center rounded-full bg-ink text-[10px] font-black text-white">{index + 1}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell bg-white/[0.60]">
    <div class="container-site">
      <div class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">AREA MAP</p>
          <h2 class="display-title mt-5 text-4xl sm:text-5xl">駅と広場の位置関係。</h2>
        </div>
        <a href={site.mapUrl} target="_blank" rel="noreferrer" class="w-fit rounded-full bg-ink px-5 py-3 text-sm font-bold text-white">地図アプリで経路を開く ↗</a>
      </div>
      <RouteMap />
    </div>
  </section>

  <section class="section-shell">
    <div class="container-site grid gap-12 lg:grid-cols-[0.65fr_1.35fr]">
      <div>
        <p class="eyebrow">ARRIVAL GUIDE</p>
        <h2 class="display-title mt-5 text-4xl sm:text-5xl">到着前に知っておくこと。</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {[
          ['地下鉄 天神駅', '13A出口が市役所・広場側に便利です。地下街から市役所方面の案内表示を目印に進みます。'],
          ['地下鉄 天神南駅', '5番出口側から北へ。地上では福岡市役所の建物を目印にすると分かりやすいルートです。'],
          ['高速バス・路線バス', '西鉄天神高速バスターミナルや「天神」周辺の各バス停から徒歩圏です。降車場所により所要時間は異なります。'],
          ['イベント開催日', '会場入口や入場列が通常と異なる場合があります。現地スタッフの案内を優先してください。'],
          ['車・タクシー', '天神中心部は交通量が多く、イベント時は周辺駐車場も混雑します。公共交通の利用がおすすめです。'],
          ['ベビーカー・車いす', '広場周辺は概ね平坦ですが、催事設備により通路幅や段差対応が変わるため、主催者案内をご確認ください。'],
        ].map(([title, body]) => (
          <article class="rounded-[1.5rem] border border-black/10 bg-white p-6">
            <h3 class="text-lg font-bold">{title}</h3>
            <p class="mt-3 text-sm leading-7 text-ink/60">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell bg-white/[0.55]">
    <div class="container-site">
      <SectionHeading
        eyebrow="BY TRAVEL MODE"
        title="交通手段で選ぶ、到着まで。"
        description="空港からの移動に加え、タクシー・車・自転車それぞれの目安と注意をまとめました。天候や荷物の量に合わせて選んでください。"
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        <article class="card-surface p-7">
          <p class="text-xs font-black tracking-[0.16em] text-moss">TAXI</p>
          <h3 class="mt-3 font-serif text-2xl font-bold">タクシーで</h3>
          <p class="mt-4 text-sm leading-7 text-ink/60">福岡空港からは約15分、目安運賃は1,500–2,000円程度。JR博多駅からは約10分、1,000–1,500円程度です。市役所西側の降車は、周辺のロータリーや路上の降車帯を。イベント時は周辺で交通規制が入る場合があります。</p>
        </article>
        <article class="card-surface p-7">
          <p class="text-xs font-black tracking-[0.16em] text-moss">CAR / RENTAL</p>
          <h3 class="mt-3 font-serif text-2xl font-bold">レンタカー・車で</h3>
          <p class="mt-4 text-sm leading-7 text-ink/60">広場専用の駐車場はありません。周辺の時間貸し駐車場を利用します。天神中心部は渋滞や一方通行が多く、大規模イベント時は広範囲で規制が入ります。公共交通の利用が安心です。</p>
        </article>
        <article class="card-surface p-7">
          <p class="text-xs font-black tracking-[0.16em] text-moss">BIKE / WALK</p>
          <h3 class="mt-3 font-serif text-2xl font-bold">レンタサイクル・徒歩</h3>
          <p class="mt-4 text-sm leading-7 text-ink/60">福岡は自転車シェアが充実。広場〜天神中央公園〜アクロス福岡は平坦で、自転車や徒歩の移動に適しています。まちをゆっくり眺めながら回れます。</p>
        </article>
        <article class="card-surface p-7">
          <p class="text-xs font-black tracking-[0.16em] text-moss">CONNECTIONS</p>
          <h3 class="mt-3 font-serif text-2xl font-bold">周辺スポットへの足</h3>
          <p class="mt-4 text-sm leading-7 text-ink/60">広場を起点に、中央公園・アクロス福岡・水鏡天満宮・旧福岡県公会堂貴賓館が徒歩圏。このページの「周辺スポット」とあわせて、まち歩きのハブにしてください。</p>
        </article>
      </div>
    </div>
  </section>

  <FaqSection />

  <section class="pb-24">
    <div class="container-site rounded-[2rem] bg-moss p-8 text-white sm:p-12">
      <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-xs font-black tracking-[0.16em] text-white/[0.55]">DESTINATION</p>
          <h2 class="mt-3 font-serif text-3xl font-bold">福岡市役所西側ふれあい広場</h2>
          <p class="mt-3 text-sm leading-7 text-white/70">{site.address}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <span class="rounded-full bg-white/10 px-4 py-2 text-sm font-bold">施設利用時間（目安） {site.hours}</span>
          <a href={site.mapUrl} target="_blank" rel="noreferrer" class="rounded-full bg-white px-5 py-3 text-sm font-black text-moss">ナビを開始 ↗</a>
        </div>
      </div>
      <p class="mt-5 text-xs leading-6 text-white/[0.65]">※8:00–21:00 は施設の利用時間の目安です。広場は都市の公共空間として基本的に自由に通行できますが、イベント開催時は会場設営・片付けに伴う立入制限がある場合があります。</p>
    </div>
  </section>
</BaseLayout>
