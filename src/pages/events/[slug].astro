---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { eventSchedule, getEventBySlug, LAST_CONFIRMED } from '@/data/events';
import { site } from '@/data/site';

export function getStaticPaths() {
  return eventSchedule
    .filter((e) => e.slug)
    .map((e) => ({ params: { slug: e.slug! } }));
}

const { slug } = Astro.params;
const event = getEventBySlug(slug!);

if (!event) return Astro.redirect('/events');

const categoryClasses: Record<string, string> = {
  '祭り': 'bg-festival text-white',
  '地域': 'bg-moss text-white',
  '文化': 'bg-night text-white',
  'スポーツ': 'bg-sun text-ink',
  '季節': 'bg-leaf text-white',
};

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.start,
  endDate: event.end,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  description: event.intro ?? `${event.title}（${event.date}）の開催情報。福岡市役所西側ふれあい広場でのイベントです。`,
  inLanguage: 'ja',
  location: {
    '@type': 'Place',
    name: '福岡市役所西側ふれあい広場',
    address: {
      '@type': 'PostalAddress',
      postalCode: '810-0001',
      addressRegion: '福岡県',
      addressLocality: '福岡市中央区',
      streetAddress: '天神1丁目8-1',
      addressCountry: 'JP',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.coordinates.latitude,
      longitude: site.coordinates.longitude,
    },
  },
  organizer: { '@type': 'Organization', name: event.organizer ?? '福岡市' },
};
---
<BaseLayout
  pageTitleOverride={`${event.title}（福岡市役所西側ふれあい広場）｜開催日時・アクセス`}
  description={`${event.title}の開催日時、場所、アクセス、主催者情報。${event.date}に福岡市役所西側ふれあい広場で開催。最終確認日と公式発表へのリンクも掲載します。`}
  image="/images/plaza/night-food-event.webp"
>
  <section class="relative min-h-[560px] overflow-hidden pt-18 lg:min-h-[640px]">
    <img src="/images/plaza/festival-dance.webp" alt="福岡市役所西側ふれあい広場で行われるイベントの様子" class="absolute inset-0 size-full object-cover" width="1920" height="1080" fetchpriority="high" />
    <div class="absolute inset-0 bg-linear-to-r from-ink/90 via-ink/[0.54] to-ink/5"></div>
    <div class="absolute inset-0 bg-linear-to-t from-ink/55 via-transparent to-transparent"></div>
    <div class="container-site relative z-10 flex min-h-[542px] items-end pb-16 pt-32 lg:min-h-[622px] lg:pb-20">
      <div class="max-w-4xl text-paper">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2 text-xs font-bold tracking-[0.12em] backdrop-blur">TENJIN / FUKUOKA</span>
          <span class:list={['rounded-full px-4 py-2 text-xs font-black', categoryClasses[event.category]]}>{event.category}</span>
        </div>
        <h1 class="display-title mt-7 text-balance text-4xl sm:text-6xl lg:text-7xl">{event.title}</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-paper/[0.78] sm:text-lg">
          福岡市役所西側ふれあい広場で開催されるイベント。開催日時・内容・アクセスをまとめた非公式ガイドです。
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/events" class="rounded-full bg-paper px-6 py-3.5 text-sm font-black text-ink transition hover:-translate-y-0.5">イベント一覧へ</a>
          <a href="/access" class="rounded-full border border-white/30 bg-white/10 px-6 py-3.5 text-sm font-bold text-white backdrop-blur transition hover:bg-white/20">アクセスを確認</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pt-4">
    <div class="container-site">
      <div class="flex flex-col gap-4 rounded-[1.5rem] border border-moss/25 bg-moss/[0.10] p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="eyebrow">LAST CONFIRMED</p>
          <p class="mt-2 font-serif text-2xl font-bold">最終確認：{LAST_CONFIRMED}</p>
          <p class="mt-1 text-sm text-ink/60">開催日時・内容は主催者・公式発表により変更される場合があります。</p>
        </div>
        {event.officialUrl && (
          <a href={event.officialUrl} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-black text-white transition hover:-translate-y-0.5">公式情報を確認 ↗</a>
        )}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container-site">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card-surface p-6">
          <p class="text-xs font-black tracking-[0.15em] text-moss">開催日</p>
          <p class="mt-3 font-serif text-xl font-bold leading-7">{event.date}</p>
        </div>
        <div class="card-surface p-6">
          <p class="text-xs font-black tracking-[0.15em] text-moss">場所</p>
          <p class="mt-3 font-serif text-xl font-bold leading-7">市役所西側<br />ふれあい広場</p>
        </div>
        <div class="card-surface p-6">
          <p class="text-xs font-black tracking-[0.15em] text-moss">入場</p>
          <p class="mt-3 font-serif text-xl font-bold leading-7">無料</p>
        </div>
        <div class="card-surface p-6">
          <p class="text-xs font-black tracking-[0.15em] text-moss">主催</p>
          <p class="mt-3 font-serif text-xl font-bold leading-7">{event.organizer ?? '福岡市'}</p>
        </div>
      </div>
      {event.note && (
        <p class="mt-4 rounded-[1.25rem] bg-white/[0.55] p-5 text-sm leading-7 text-ink/70">{event.note}</p>
      )}
    </div>
  </section>

  <section class="section-shell">
    <div class="container-narrow">
      <SectionHeading eyebrow="ABOUT" title="イベントについて。" />
      <p class="mt-8 text-base leading-8 text-ink/70">{event.intro}</p>
    </div>
  </section>

  {event.access && (
    <section class="section-shell bg-white/[0.55]">
      <div class="container-narrow">
        <SectionHeading eyebrow="ACCESS" title="アクセス。" />
        <p class="mt-8 text-base leading-8 text-ink/70">{event.access}</p>
        <a href="/access" class="mt-7 inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white">詳しい交通案内</a>
      </div>
    </section>
  )}

  {event.rainNote && (
    <section class="section-shell">
      <div class="container-narrow rounded-[2rem] border border-black/10 bg-white p-7">
        <p class="eyebrow">WEATHER & NOTICE</p>
        <p class="mt-4 text-base leading-8 text-ink/70">{event.rainNote}</p>
      </div>
    </section>
  )}

  <section class="pb-24">
    <div class="container-narrow rounded-[2rem] border border-black/10 bg-white p-8 text-center sm:p-12">
      <p class="eyebrow justify-center before:hidden">PLAN YOUR VISIT</p>
      <h2 class="display-title mt-5 text-4xl">広場への行き方を確認。</h2>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-ink/60">最寄り駅・出口、周辺駐車場、大規模イベント時の混雑についてまとめています。</p>
      <a href="/access" class="mt-7 inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white">アクセスページへ</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)}></script>
</BaseLayout>
