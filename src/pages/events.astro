---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import EventsUpcoming from '@/components/EventsUpcoming.astro';
import FaqSection from '@/components/FaqSection.astro';
import { eventSchedule, eventTips, getEventNowModule, getEventsByYearMonth, LAST_CONFIRMED } from '@/data/events';
import { site } from '@/data/site';

const categoryClasses = {
  '祭り': 'bg-festival text-white',
  '地域': 'bg-moss text-white',
  '文化': 'bg-night text-white',
  'スポーツ': 'bg-sun text-ink',
  '季節': 'bg-leaf text-white',
};

const now = new Date();
const { heading, events: nowEvents } = getEventNowModule(now);
const octoberEvents = getEventsByYearMonth(2026, 10, now);

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: eventSchedule.map((e, i) => ({
    '@type': 'Event',
    position: i + 1,
    name: e.title,
    startDate: e.start,
    endDate: e.end,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: {
      '@type': 'Place',
      name: '福岡市役所西側ふれあい広場',
      address: {
        '@type': 'PostalAddress',
        postalCode: '810-0001',
        addressRegion: '福岡県',
        addressLocality: '福岡市中央区',
        streetAddress: '天神1丁目8-1',
        addressCountry: 'JP',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.coordinates.latitude,
        longitude: site.coordinates.longitude,
      },
    },
    organizer: { '@type': 'Organization', name: e.organizer ?? '福岡市' },
  })),
};
---
<BaseLayout pageTitleOverride="福岡市役所前広場のイベント【2026年10月】｜今日・週末の開催予定"
  description="福岡市役所西側ふれあい広場の2026年10月イベント予定。10月17日・18日の筑後川のめぐみフェスティバルなど、開催日時・内容・アクセスを確認できます。情報更新日と公式発表へのリンクも掲載。"
  image="/images/plaza/night-food-event.webp">
  <PageHero
    eyebrow="EVENTS & FESTIVALS"
    title="福岡市役所西側ふれあい広場のイベント情報"
    description="天神の街なかで開かれる祭り、物産展、体験イベント。開催日時とアクセスをまとめています。"
    image="/images/plaza/night-food-event.webp"
    imageAlt="飲食ブースと来場者でにぎわう夜のふれあい広場"
  />

  <section class="section-shell pt-4">
    <div class="container-site">
      <div class="flex flex-col gap-4 rounded-[1.5rem] border border-moss/25 bg-moss/[0.10] p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="eyebrow">LAST CONFIRMED</p>
          <p class="mt-2 font-serif text-2xl font-bold">最終確認：{LAST_CONFIRMED}</p>
          <p class="mt-1 text-sm text-ink/60">開催日時・内容は主催者・公式発表により変更される場合があります。来場前に最新情報をご確認ください。</p>
        </div>
        <a href="https://fureaihiroba.jp/" target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-black text-white transition hover:-translate-y-0.5">公式サイトで確認 ↗</a>
      </div>
    </div>
  </section>

  <EventsUpcoming
    events={nowEvents}
    heading={heading}
    note={`最終確認：${LAST_CONFIRMED}。掲載は2026年度の年間予定（参考）。開催日時は主催者の最新案内をご確認ください。`}
  />

  <section class="section-shell">
    <div class="container-site">
      <SectionHeading eyebrow="OCTOBER 2026" title="今月（2026年10月）の開催予定。" description="天神の街なかで開かれる今月の主なイベント。詳細・公式情報は各イベント名から確認できます。" />
      <div class="mt-12 overflow-hidden rounded-[2rem] border border-black/10 bg-white">
        {octoberEvents.map((event, index) => (
          <article class:list={['grid gap-4 p-6 sm:grid-cols-[150px_1fr_auto] sm:items-center sm:p-7', index !== octoberEvents.length - 1 && 'border-b border-black/[0.08]']}>
            <p class="font-serif text-xl font-bold">{event.date}</p>
            <div>
              <h3 class="text-lg font-bold">{event.title}</h3>
              {event.note && <p class="mt-1 text-sm leading-6 text-ink/[0.55]">{event.note}</p>}
              {event.slug && (
                <a href={`/events/${event.slug}`} class="mt-2 inline-flex items-center gap-1 text-sm font-bold text-moss">詳しく見る <span aria-hidden="true">↗</span></a>
              )}
            </div>
            <span class:list={['w-fit rounded-full px-3 py-1.5 text-xs font-black', categoryClasses[event.category]]}>{event.category}</span>
          </article>
        ))}
      </div>
      <p class="mt-5 text-xs leading-6 text-ink/50">※掲載内容は各催事の公表資料を参考にしています。最新情報は主催者・公式サイト（fureaihiroba.jp）の発表をご確認ください。</p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container-site">
      <SectionHeading eyebrow="2026 SCHEDULE" title="2026年度 主な開催予定。" description="公式公開資料をもとに整理した予定です。天候、会場都合、主催者判断により変更・中止となる場合があります。" />
      <div class="mt-12 overflow-hidden rounded-[2rem] border border-black/10 bg-white">
        {eventSchedule.map((event, index) => (
          <article class:list={['grid gap-4 p-6 sm:grid-cols-[150px_1fr_auto] sm:items-center sm:p-7', index !== eventSchedule.length - 1 && 'border-b border-black/[0.08]']}>
            <p class="font-serif text-xl font-bold">{event.date}</p>
            <div>
              <h3 class="text-lg font-bold">{event.title}</h3>
              {event.note && <p class="mt-1 text-sm leading-6 text-ink/[0.55]">{event.note}</p>}
            </div>
            <span class:list={['w-fit rounded-full px-3 py-1.5 text-xs font-black', categoryClasses[event.category]]}>{event.category}</span>
          </article>
        ))}
      </div>
      <p class="mt-5 text-xs leading-6 text-ink/50">※掲載内容は2026年公表の年間予定および各催事案内を参考にしています。最新情報は各イベント主催者の発表をご確認ください。</p>
    </div>
  </section>

  <section class="section-shell bg-ink text-paper">
    <div class="container-site">
      <SectionHeading eyebrow="VISIT TIPS" title="イベントの日を、もっと楽しむ。" />
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {eventTips.map((tip, index) => (
          <article class="rounded-[1.75rem] border border-white/[0.12] bg-white/[0.06] p-7">
            <span class="font-serif text-5xl font-bold text-sun/40">0{index + 1}</span>
            <h3 class="mt-7 text-xl font-bold">{tip.title}</h3>
            <p class="mt-4 text-sm leading-7 text-paper/60">{tip.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container-narrow rounded-[2rem] border border-black/10 bg-white p-8 text-center sm:p-12">
      <p class="eyebrow justify-center before:hidden">ACCESS & FAQ</p>
      <h2 class="display-title mt-5 text-4xl">アクセスとよくある質問。</h2>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-ink/60">最寄り駅・出口、雨天時の過ごし方、駐車場、バリアフリー情報をまとめました。大規模イベント日は天神周辺が混雑します。</p>
      <a href="/access" class="mt-7 inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white">詳しい交通案内</a>
    </div>
  </section>

  <FaqSection />

  <section class="pb-24">
    <div class="container-site grid gap-6 md:grid-cols-2">
      <figure class="overflow-hidden rounded-[2rem]">
        <img src="/images/plaza/festival-dance.webp" alt="祭りの演舞と観客" class="aspect-[4/3] w-full object-cover" width="1000" height="750" loading="lazy" />
      </figure>
      <figure class="overflow-hidden rounded-[2rem]">
        <img src="/images/plaza/night-aerial.webp" alt="夜空の下で開催される広場イベント" class="aspect-[4/3] w-full object-cover" width="1000" height="750" loading="lazy" />
      </figure>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)}></script>
</BaseLayout>
